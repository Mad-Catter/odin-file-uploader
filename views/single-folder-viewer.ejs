<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon" />
		<link rel="stylesheet" href="/style.css" />
	</head>
	<body>
		<%- include("./partials/header") %>
		<h1>This is the single folder viewer</h1>
		<% if (!locals.invalid) { %>
			<div class="files">
				<h1><%=folder.name%></h1>
				<% for (const file of folder.files) {%>
					<a href="<%=locals.url%>/<%=file.id%>"><%=file.originalName%></a>
				<%}%>
			</div>
		<% } else { %>
			<h1>The link you used is either expired or invalid.</h1>
		<% } %>
		
	</body>
</html>
