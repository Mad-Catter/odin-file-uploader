<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon" />
		<link rel="stylesheet" href="/style.css" />
		<script src="js/allFoldersViewer.js" defer></script>
	</head>
	<body>
		<%- include("./partials/header") %>
		<h1>This is the all folder viewer</h1>
		<form action="/folder/create-folder" method="POST">
			<label for="name">Folder Name:</label>
			<input type="text" name="folderName" id="name" required minlength="1"/>
			<button type="submit">submit</button>
		</form>
		<h1>HERE BE FOLDERS</h1>
		<% for (folder of locals.folders) { %>
			<%- include("./partials/folder") %>
		<%} %>
		<dialog id="share-modal">
			<form action="/share/create-link" method="post" id="share-form">
				<input type="hidden" name="folderId" id="share-id">
				<label for="duration">Amount of days the link will work:</label>
				<input type="number" name="duration" id="duration" value="1" max="31" min="1" step="1" required>
				<button type="submit">Submit</button>
			</form>
			<button type="button" id="close-button" onClick="closeShareModal()">Close</button>
			<p class="hidden" id="creating">Creating share link...</p>
			<p class="hidden error" id="share-error">An error occured creating your share link!</p>
			<div class="hidden" id="link-div">
				<input type="text" readonly id="share-link">
				<button type="button" onClick="copyLink()">Copy Link</button>
			</div>
		</dialog>
	</body>
	
</html>
